# ==============================================
# VeriWrite AI - Backend Environment Configuration
# Safe placeholder template for production and development.
# Do NOT place actual passwords or secrets in this file.
# ==============================================

# Server Runtime
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Authentication / Security
JWT_SECRET=change-me-to-a-secure-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# CORS / Allowed Frontend URLs (comma-separated for multiple origins)
FRONTEND_URL=https://your-frontend.vercel.app
CLIENT_URL=https://your-frontend.vercel.app

# OpenRouter (AI Writing Analysis)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Copyleaks (Plagiarism Detection Service)
# Note: Auth and API URLs are separate per Copyleaks architecture
COPYLEAKS_AUTH_URL=https://id.copyleaks.com
COPYLEAKS_API_URL=https://api.copyleaks.com
COPYLEAKS_API_KEY=your_copyleaks_api_key_here
COPYLEAKS_EMAIL=your_copyleaks_registered_email_here
COPYLEAKS_SANDBOX=false
# Webhook URL format: https://<your-render-service>.onrender.com/api/copyleaks/webhook/{STATUS}
COPYLEAKS_WEBHOOK_URL=https://your-backend.onrender.com/api/copyleaks/webhook/{STATUS}

# Optional Search Providers (Tavily / Serper if enabled)
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your_tavily_api_key_here
SERPER_API_KEY=your_serper_api_key_here

# File Upload Limit (bytes - default 5MB)
MAX_FILE_SIZE=5242880